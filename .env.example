PORT=3001
MALIX_SOURCE_URL=https://tv12.lk21official.cc
MALIX_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Host media tambahan, pisahkan dengan koma bila stream merujuk CDN lain.
MALIX_MEDIA_HOSTS=
# Tampilkan log request/response jaringan Puppeteer di terminal.
MALIX_TRACE=0
# Chrome berjalan tanpa jendela. Set 0 untuk menampilkan Chrome.
MALIX_HEADLESS=1
# Opsional: JSON berisi server TURN untuk kamera/mikrofon lintas jaringan.
MALIX_ICE_SERVERS=
